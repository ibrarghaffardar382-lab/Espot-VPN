{
  "manifest_version": 3,
  "name": "Espot VPN",
  "version": "1.0.0",
  "description": "Connect securely through your Espot VPN account. Routes browser traffic through your assigned proxy.",
  "permissions": ["proxy", "storage", "webRequest", "webRequestAuthProvider", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Espot VPN",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
